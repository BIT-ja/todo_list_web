.editor {
  padding: 28rpx;
}

.editor-title {
  margin-bottom: 22rpx;
  color: #1f2933;
  font-size: 34rpx;
  font-weight: 800;
}

.input-line,
.color-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-top: 1rpx solid #f0f2f5;
}

.input-label {
  flex: 0 0 112rpx;
  color: #646566;
  font-size: 27rpx;
}

.input-line input,
.picker-value {
  flex: 1;
  color: #323233;
  font-size: 28rpx;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.color-dot {
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid transparent;
  border-radius: 50%;
}

.color-dot--active {
  border-color: #323233;
  box-shadow: 0 0 0 4rpx #fff inset;
}

.preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  color: #323233;
  font-size: 28rpx;
  background: #f7f8fa;
}

.preview-icon,
.category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 28rpx;
}

.save-button {
  margin-top: 24rpx;
}

.cancel-button {
  margin-top: 16rpx;
}

.category-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.category-row {
  display: flex;
  align-items: center;
  padding: 22rpx;
}

.category-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.category-name {
  color: #323233;
  font-size: 30rpx;
  font-weight: 700;
}

.category-sub {
  margin-top: 4rpx;
  color: #969799;
  font-size: 22rpx;
}

.text-button {
  width: 82rpx;
  height: 54rpx;
  padding: 0;
  border: 0;
  color: #1989fa;
  font-size: 24rpx;
  line-height: 54rpx;
  background: transparent;
}

.text-button.delete {
  color: #ee0a24;
}
