<view class="auth-page">
  <view class="hero-card">
    <view class="hero-logo">✓</view>
    <view class="hero-title">组织待办</view>
    <view class="hero-subtitle">微信一键登录后即可查看组织内待办</view>
  </view>

  <view class="auth-actions">
    <button class="primary-button" loading="{{wechatLoading}}" bindtap="handleWechatLogin">微信一键登录</button>
    <button class="plain-button" bindtap="goJoin">首次使用，填写邀请码加入</button>
    <button class="plain-button" bindtap="goBind">已有账号，绑定微信</button>
  </view>

  <view class="password-panel card">
    <view class="panel-title">账号密码登录</view>
    <view class="input-row">
      <input value="{{username}}" placeholder="用户名" bindinput="onUsernameInput" />
    </view>
    <view class="input-row">
      <input value="{{password}}" password placeholder="密码" bindinput="onPasswordInput" />
    </view>
    <button class="plain-button login-button" loading="{{passwordLoading}}" bindtap="handlePasswordLogin">登录</button>
  </view>
</view>
