.auth-page {
  min-height: 100vh;
  padding: 64rpx 36rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #edf5ff 0%, #f7f8fa 42%);
}

.hero-card {
  padding: 56rpx 36rpx;
  text-align: center;
}

.hero-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 36rpx;
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1989fa, #7b61ff);
  box-shadow: 0 18rpx 38rpx rgba(25, 137, 250, 0.24);
}

.hero-title {
  margin-top: 28rpx;
  color: #1f2933;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: #7d8da6;
  font-size: 28rpx;
}

.auth-actions {
  display: grid;
  gap: 20rpx;
}

.password-panel {
  margin-top: 36rpx;
  padding: 28rpx;
}

.panel-title {
  margin-bottom: 20rpx;
  color: #323233;
  font-size: 30rpx;
  font-weight: 700;
}

.input-row {
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #eef0f4;
  border-radius: 18rpx;
  background: #f9fafc;
}

.input-row + .input-row {
  margin-top: 16rpx;
}

.input-row input {
  width: 100%;
  height: 88rpx;
  color: #323233;
  font-size: 28rpx;
}

.login-button {
  margin-top: 22rpx;
}
