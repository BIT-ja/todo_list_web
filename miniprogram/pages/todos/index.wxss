.todo-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx 22rpx;
}

.title {
  color: #1f2933;
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 6rpx;
  color: #7d8da6;
  font-size: 24rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1989fa, #7b61ff);
}

.tabs {
  display: flex;
  gap: 14rpx;
  padding: 8rpx 0 18rpx;
}

.tab {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  color: #646566;
  font-size: 28rpx;
  line-height: 68rpx;
  text-align: center;
  background: #fff;
}

.tab--active {
  color: #fff;
  font-weight: 700;
  background: #1989fa;
}

.empty-button {
  width: 320rpx;
  margin-top: 32rpx;
}

.todo-list {
  display: grid;
  gap: 20rpx;
}

.todo-shell {
  position: relative;
  overflow: hidden;
  min-height: 206rpx;
  border-radius: 24rpx;
}

.todo-shell--dragging {
  opacity: 0.72;
  transform: scale(0.985);
}

.complete-bg {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  padding-left: 44rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #07c160, #5bd88f);
  transition: color 160ms ease;
}

.complete-bg--active {
  color: #fff;
}

.row-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 216rpx;
}

.action {
  flex: 1;
  height: 100%;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: #fff;
  font-size: 22rpx;
  line-height: 206rpx;
}

.action-pin {
  background: #1989fa;
}

.action-urgent {
  background: #ff976a;
}

.action-delete {
  background: #ee0a24;
}

.todo-card {
  position: relative;
  z-index: 2;
  display: flex;
  min-height: 206rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  transition: transform 160ms ease;
}

.category-icon {
  display: flex;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  color: #fff;
  font-size: 32rpx;
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.todo-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-title--done {
  color: #969799;
  text-decoration: line-through;
}

.mini-tag {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  line-height: 34rpx;
}

.pin-tag {
  background: #1989fa;
}

.urgent-tag {
  background: #ee0a24;
}

.todo-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #646566;
  font-size: 26rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.todo-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.due-warning {
  color: #ff7a00;
  background: #fff4e6;
}

.due-danger {
  color: #ee0a24;
  background: #ffecec;
}

.todo-footer {
  margin-top: 14rpx;
  color: #969799;
  font-size: 24rpx;
  line-height: 34rpx;
}

.fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(env(safe-area-inset-bottom) + 42rpx);
  z-index: 20;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #fff;
  font-size: 58rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1989fa, #7b61ff);
  box-shadow: 0 16rpx 36rpx rgba(25, 137, 250, 0.3);
}
