page {
  min-height: 100%;
  color: #1f2933;
  background: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
}

.card {
  background: #fff;
  border: 1rpx solid #eef0f4;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}

.primary-button {
  height: 88rpx;
  border: 0;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1989fa, #7b61ff);
}

.plain-button {
  height: 80rpx;
  border: 1rpx solid #d7dce5;
  border-radius: 999rpx;
  color: #323233;
  font-size: 28rpx;
  line-height: 80rpx;
  background: #fff;
}

.danger-button {
  height: 80rpx;
  border: 1rpx solid #ee0a24;
  border-radius: 999rpx;
  color: #ee0a24;
  font-size: 28rpx;
  line-height: 80rpx;
  background: #fff;
}

.field-card {
  overflow: hidden;
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
}

.field-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
  box-sizing: border-box;
}

.field-row:last-child {
  border-bottom: 0;
}

.field-label {
  flex: 0 0 152rpx;
  color: #646566;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  color: #323233;
  font-size: 28rpx;
}

.textarea-row {
  align-items: flex-start;
  padding-top: 26rpx;
  padding-bottom: 26rpx;
}

.textarea-input {
  width: 100%;
  min-height: 132rpx;
  color: #323233;
  font-size: 28rpx;
  line-height: 40rpx;
}

.muted {
  color: #969799;
}

.empty-state {
  padding: 120rpx 32rpx;
  color: #969799;
  font-size: 28rpx;
  text-align: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #646566;
  font-size: 22rpx;
  background: #f2f4f7;
}
